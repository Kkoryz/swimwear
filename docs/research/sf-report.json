  "issues": [
    {
      "source": "design-review",
      "route": "/",
      "section": "hero",
      "kind": "design_finding",
      "detail": "The hero photo still has another banner's text printed into it (\"Swim for Sunlit Days\", \"and summer-ready prints\" and the outlines of \"Shop Swimwear\" and \"Explore the Collection\" buttons), and our H1, lead and Request a quote button sit right on top of it, so two sets of text overlap at 1440 px (the phone crop hides it)."
    },
    {
      "source": "design-review",
      "route": "/",
      "section": "trustBar",
      "kind": "design_finding",
      "detail": "Two trust figures still read as broken fragments (\"65 that / SAMPLING TEAM\", \"55 custom / DAILY SAMPLES\"), and \"100,000 pieces\" has its unit in the value, so on phones it wraps to two lines and its label drops out of line with \"FOUNDED\"."
    },
    {
      "source": "design-review",
      "route": "/",
      "section": "featureGrid-7",
      "kind": "design_finding",
      "detail": "The card sets featureGrid-4 (private label and logo), featureGrid-7 (quotation to sampling), featureGrid-9 (MOQ and fees) and featureGrid-1 (only a lead sentence) still have no heading, so the page jumps from m3's \"OEM Swimwear Production\" to packaging, ordering and payment terms with nothing to show the topic has changed."
    },
    {
      "source": "design-review",
      "route": "/about-us/",
      "section": "trustBar",
      "kind": "design_finding",
      "detail": "Two of the four figures are still cut-off phrases ('65 that' over 'SAMPLING TEAM', '55 custom' over 'DAILY SAMPLES'), so the bar reads as broken copy at both widths."
    },
    {
      "source": "design-review",
      "route": "/blog/",
      "section": "overview-steps",
      "kind": "design_finding",
      "detail": "The section has no heading. Its only intro is the body-size caption \"Quality checks at every stage of an order.\", so the left column is a single small line beside a long list, between two bold H2 sections."
    },
    {
      "source": "design-review",
      "route": "/watersports-apparel-manufacturer/",
      "section": "hero",
      "kind": "design_finding",
      "detail": "The desktop hero photo has its own headline ('Swim for Sunlit Days'), lead and two buttons printed into the picture; they compete with the real H1 below it, and the frame's bottom edge cuts the second printed button in half."
    },
    {
      "source": "design-review",
      "route": "/swimwear-consulting/",
      "section": "faq-steps",
      "kind": "design_finding",
      "detail": "The navy step band has no heading in the page at all (no heading in the markup), so after the FAQ it reads as five loose figures with a button."
    },
    {
      "source": "design-review",
      "route": "/custom-swimwear-printing/",
      "section": "hero",
      "kind": "design_finding",
      "detail": "The hero photo (general-hero-1) has its own headline 'Swim for Sunlit Days', a subline and two buttons ('Shop Swimwear', 'Explore the Collection') printed into the image, and they show through faintly behind our H1, lead and button, so the hero reads as two layers of overlapping text and dead buttons."
    },
