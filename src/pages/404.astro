---
// Not-found page in the site shell (served with status 404 by the web server).
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist." robots="noindex, follow" shell>
  <main id="main" class="not-found">
    <div class="container not-found__inner">
      <h1>Page not found</h1>
      <p>The page you are looking for does not exist or has moved.</p>
      <a class="button button--primary" href="/">Go to the home page</a>
    </div>
  </main>
</BaseLayout>
