---
// The blog hub, headed the way the reference blog is (variants.blog.hub.header): hero (heading and intro beside the
// hub's hero photo), plain (a centred heading), featured (the newest post as a large card under the heading),
// banner (a photo banner with the heading over it).
import { cardSet, cardSetColumns } from '../../../scripts/lib/block-layout.mjs';
import { headingFitStyle, wrapEmFor } from '../../../scripts/lib/heading-fit.mjs';
import { markFirstViewportImage, withMediaModules } from '../../../scripts/lib/media-slots.mjs';
import { tintedSections, tintStyle } from '../../../scripts/lib/section-surfaces.mjs';
import { blockVariant, blogVariants, focusStyle, isBuilt, pageMedia, variants, type AuthoringPage, type PostListBlock } from '../../lib/authoring';
import { BLOCKS, type BlockEntry } from '../blocks/registry';
import Breadcrumbs from '../site/Breadcrumbs.astro';
import PostDate from './PostDate.astro';
import PostListBlockView from './PostListBlock.astro';

interface Props { page: AuthoringPage }
const { page } = Astro.props;
const header = blogVariants.hub.header;
// The hub's title sized to its own words, as a page's is (scripts/lib/heading-fit.mjs; template.css [data-heading-fit]).
const hubFit = headingFitStyle(page.hero.heading, { charEm: wrapEmFor(variants.heroText) });
// The hub's own blocks (Site Factory's copy, lib/blog.mjs hubPages) around its post list, each by its registry component.
const list = page.blocks.find((block) => block.type === 'postList') as PostListBlock | undefined;
// The blocks as every other page places them (media-slots.mjs withMediaModules): a section's steps drawn after it, as
// the layout audit and the image plan count them (Strandmill 2026-11-14: the hub's intro steps were not drawn).
const blocks = withMediaModules(page, variants, { isBuilt }) as AuthoringPage['blocks'];
const plan = pageMedia(page.route);
let splits = 0;
// A card set going on in grids of its own keeps one card width, as on every other page (PageView, block-layout.mjs).
const setColumns = cardSetColumns(blocks);
const own = blocks.map((source, index) => {
  if (source.type === 'postList') return null;
  const columns = source.type === 'featureGrid' ? setColumns.get(cardSet(source)) : undefined;
  const block = columns ? { ...source, setColumns: columns } : source;
  const splitIndex = block.type === 'splitMedia' ? splits++ : 0;
  return { entry: BLOCKS[block.type as keyof typeof BLOCKS] as BlockEntry, context: { block, variant: blockVariant(block, page.pageType, splitIndex), page, formId: null, media: plan[index] ?? [], splitIndex } };
});
const newest = list?.items[0];
// The header photo is the hub's own hero (the image plan's photo for this route), so it does not repeat the first card.
const photo = variants.media.heroByRoute?.[page.route] ?? newest?.image ?? null;
// The featured header shows the newest post itself on the first page; the list below starts after it.
const featured = list && header === 'featured' && list.pagination.page === 1 && list.items.length > 1 ? newest : null;
const rest = list && featured ? { ...list, items: list.items.slice(1) } : list;
// Neighbouring plain sections alternate white and tinted here too, the post list one of them (lib/section-surfaces.mjs;
// 2026-11-15: swimwear's hub ran its overview, steps and table on white one under another, motel's its lead, posts and
// overview).
const variantOf = new Map(own.filter(Boolean).map((item) => [item!.context.block.id, item!.context.variant]));
const shown = blocks.filter((block) => block.type !== 'postList' || (rest && rest.items.length > 0));
const tintCss = tintStyle(new Set([...tintedSections(shown, (block) => variantOf.get(block.id))].flatMap((id) => [id, `${id}-charts`])), { secondaryInk: variants.secondaryInk === true });
// Without a photo in its header, the first section's first image may sit in the first viewport: it loads eagerly (as
// PageView, media-slots.mjs markFirstViewportImage).
if (!((['banner', 'hero'].includes(header) && photo) || featured?.image)) markFirstViewportImage(plan);
---

<main id="main" data-authoring-page={page.id} data-page-type={page.pageType} data-page-status={page.status} data-hero-photo={header === 'banner' && photo ? '' : undefined}>
  {tintCss && <style is:inline set:html={tintCss} />}
  {header !== 'banner' && <Breadcrumbs page={page} />}
  <section class="blog-hub-hero" data-authoring-block="hero" data-layout="hero" data-header={header} data-boundary-anchor={header === 'banner' ? 'box' : undefined}>
    {header === 'banner' && photo && <img class="blog-hub-hero__backdrop" src={photo.src} srcset={photo.srcset} sizes={photo.srcset ? '100vw' : undefined} alt="" data-decorative width={photo.width} height={photo.height} loading="eager" fetchpriority="high" decoding="async" style={focusStyle(photo.src)} />}
    <div class="container blog-hub-hero__inner">
      <div class="blog-hub-hero__copy" data-heading-fit={hubFit ? '' : undefined} style={hubFit}>
        {page.status === 'placeholder' && <p class="placeholder-badge">Placeholder copy</p>}
        <h1>{page.hero.heading}</h1>
        {/* The lead under the title in the first screen, as on every hero (PageHero.astro; site13 claude-seo audit 2026-11-17, M-10). */}
        {page.hero.lead?.map((paragraph) => <p class="blog-hub-hero__lead">{paragraph}</p>)}
      </div>
      {header === 'hero' && photo && <figure class="blog-hub-hero__media media-box" style="--media-ratio: 4 / 3"><img src={photo.src} alt="" data-decorative width={photo.width} height={photo.height} loading="eager" fetchpriority="high" decoding="async" style={focusStyle(photo.src)} /></figure>}
      {featured && (
        <a class="blog-featured" href={featured.href}>
          {featured.image && <img class="blog-featured__image" src={featured.image.src} alt="" data-decorative width={featured.image.width} height={featured.image.height} loading="eager" decoding="async" style={focusStyle(featured.image.src)} />}
          <span class="blog-featured__copy">
            <span class="blog-featured__title">{featured.title}</span>
            <PostDate value={featured.date} />
          </span>
        </a>
      )}
    </div>
  </section>
  {header === 'banner' && <Breadcrumbs page={page} />}
  {/* No trust bar here: a reader comes for the posts, which follow the heading (lib/blog.mjs hubPages). */}
  {own.map((item) => {
    if (!item) return rest && rest.items.length > 0 && <PostListBlockView block={rest} />;
    const { component: Component, props } = item.entry;
    return <Component {...props(item.context)} />;
  })}
</main>
