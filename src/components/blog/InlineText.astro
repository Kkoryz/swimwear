---
// One paragraph with the links its writer placed inline ([label](/route/)); internal links to unbuilt pages stay text.
// Its links are links in running text (a.inline-link, template.css): underlined, not told apart by colour alone.
import { inlineParts } from '../../../scripts/lib/blog.mjs';
import SmartLink from '../site/SmartLink.astro';

interface Props { text: string }
const parts = inlineParts(Astro.props.text) as { text: string; href?: string }[];
---

{parts.map((part) => (part.href ? (part.href.startsWith('/') ? <SmartLink href={part.href} class="inline-link">{part.text}</SmartLink> : <a class="inline-link" href={part.href} rel="noopener">{part.text}</a>) : part.text))}
