---
// The hub's posts. Cards follow the reference blog's card (variants.blog.hub.card): title (title only, shadowed),
// wide (wide photo, serif title, excerpt, arrow link), bordered (bordered, large title, excerpt, date), meta (photo,
// date row, excerpt, solid button). Numbered pages link as plain <a href> so every page can be crawled.
import { blogVariants, focusStyle, gridPlan, type PostListBlock } from '../../lib/authoring';
import { publishedSrcset } from '../../../scripts/lib/web-image.mjs';
import PostDate from './PostDate.astro';

interface Props { block: PostListBlock }
const { block } = Astro.props;
const card = blogVariants.hub.card;
const { page, pages, base } = block.pagination;
// Up to three cards a row, as many as leave no card alone on the last row (4 posts: two rows of two); one or two
// posts keep the size of a third, centred.
const columns = block.items.length < 3 ? 3 : gridPlan(block.items.length, 3).columns;
// From 768px the cards are an equal grid (patterns.css [data-layout="equal-grid"]: two tracks a column, the first card
// of a short last row starting where the row is centred) whose cards share their rows (subgrid): a title one line
// longer than its neighbour's no longer pushes the date and the excerpt down (the hotel blog: 28px apart). The rows are
// the same parts in every card: a category row while any post has one.
const count = block.items.length;
const start = (size: number, index: number) => { const remainder = count % size; return remainder && index === count - remainder ? size - remainder + 1 : null; };
const itemStyle = (index: number) => [start(columns, index) && `--start: ${start(columns, index)}`, start(2, index) && `--start-md: ${start(2, index)}`].filter(Boolean).join('; ') || undefined;
const categories = card !== 'title' && block.items.some((item) => item.category);
const bodyRows = 1 + (categories ? 1 : 0) + (card !== 'title' ? 2 : 0) + (card === 'wide' || card === 'meta' ? 1 : 0);
const href = (number: number) => (number === 1 ? base : `${base}page/${number}/`);
// A card's photo at the size its column shows it (patterns.css .post-grid: one column on a phone, two from 768px,
// `columns` from 1100px), from the sizes built for it (lib/web-image.mjs publishedSrcset: a post's image keeps its
// widest file only; 2026-11-20, MotelPilot's /blog/ loaded the 1536px file first on a phone, the 960 one built).
const srcset = (image: { src: string; srcset?: string }) => image.srcset ?? publishedSrcset(image.src) ?? undefined;
const cardSizes = `(min-width: 1100px) ${Math.ceil(100 / columns)}vw, (min-width: 768px) 50vw, 100vw`;
---

<section class="block block--posts" data-authoring-block="postList" data-block-id={block.id} data-card={card}>
  <div class="container">
    <ul class="post-grid" data-layout="equal-grid" style={`--post-max: ${columns}; --tracks: ${columns * 2}; --tracks-md: 4; --body-rows: ${bodyRows}`}>
      {block.items.map((item, index) => (
        <li class="post-card" style={[`--card-rows: ${bodyRows + (item.image ? 1 : 0)}`, itemStyle(index)].filter(Boolean).join('; ')}>
          {item.image && (
            <a class="post-card__media" href={item.href} tabindex="-1" aria-hidden="true">
              <img src={item.image.src} srcset={srcset(item.image)} sizes={srcset(item.image) ? cardSizes : undefined} alt="" data-decorative width={item.image.width} height={item.image.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" style={focusStyle(item.image.src)} />
            </a>
          )}
          <div class="post-card__body">
            {categories && <p class="post-card__category">{item.category ?? ''}</p>}
            <h2 class="post-card__title"><a href={item.href}>{item.title}</a></h2>
            {card !== 'title' && <p class="post-card__meta"><PostDate value={item.date} /></p>}
            {card !== 'title' && <p class="post-card__excerpt">{item.excerpt}</p>}
            {/* The link's name starts with its visible words (WCAG 2.5.3 label in name: a voice user says "Read more"); the
                post's title follows so each link is told apart (site audit 2026-11-19: "Read: title" on 13 links). */}
            {card === 'wide' && <a class="post-card__more" href={item.href} aria-label={`Read more: ${item.title}`}>Read more<span aria-hidden="true"> →</span></a>}
            {card === 'meta' && <a class="button button--primary post-card__button" href={item.href} aria-label={`Read more: ${item.title}`}>Read more</a>}
          </div>
        </li>
      ))}
    </ul>
    {pages > 1 && (
      <nav class="pagination" aria-label="Blog pages">
        <ol class="pagination__list">
          {Array.from({ length: pages }, (_, index) => index + 1).map((number) => (
            <li>{number === page ? <span aria-current="page">{number}</span> : <a href={href(number)}>{number}</a>}</li>
          ))}
          {page < pages && <li><a href={href(page + 1)} rel="next">Next</a></li>}
        </ol>
      </nav>
    )}
  </div>
</section>
