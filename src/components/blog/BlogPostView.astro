---
// An article, laid out the way the reference blog lays out its posts (variants.blog.post.layout):
// sidebar-start (title band; contents and author on the left of the text), narrow (full-width photo, centred title,
// one narrow column), paper (the article on a card; related posts after it), sidebar-end (photo, title bar, a contents
// box in the text, newest posts on the right). No figures bar: it sits between the title and the opening answer
// (owner 2026-10-30).
import { headingFitStyle, POST_TITLE_FIT, wrapEmFor } from '../../../scripts/lib/heading-fit.mjs';
import { experience } from '../../../scripts/lib/site-people.mjs';
import { photoSrcset } from '../../../scripts/lib/web-image.mjs';
import { articleRhythmStyle, blogVariants, builtRoutes, focusStyle, pages, siteIdentity, variants, type AuthoringPage, type ProseBlock } from '../../lib/authoring';
import CtaBlock from '../blocks/CtaBlock.astro';
import FaqBlock from '../blocks/FaqBlock.astro';
import SourcesBlock from '../blocks/SourcesBlock.astro';
import Breadcrumbs from '../site/Breadcrumbs.astro';
import SmartLink from '../site/SmartLink.astro';
import InlineText from './InlineText.astro';
import PostDate from './PostDate.astro';
import ProseBlockView from './ProseBlock.astro';

interface Props { page: AuthoringPage }
const { page } = Astro.props;
const article = page.article!;
const { layout } = blogVariants.post;
const sections = page.blocks.filter((block): block is ProseBlock => block.type === 'prose');
// A person of the site's team (scripts/lib/site-people.mjs withPostAuthors) carries their role: the post closes on their
// card, linked to their profile on the about page (four-site audit 2026-11-17: no named author anywhere).
const aboutRoute = pages.find((other) => other.pageType === 'about')?.route ?? (builtRoutes.has('/about/') ? '/about/' : '/');
const author = article.author.type === 'Person'
  ? { name: article.author.name!, href: article.author.url!, role: article.author.jobTitle, bio: article.author.description, years: article.author.years }
  : { name: siteIdentity?.siteName ?? '[Placeholder] Company', href: aboutRoute };
// The author's card closes the article's text, before its FAQ, sources and closing call.
const lastProse = page.blocks.findLastIndex((block) => block.type === 'prose');
const card = 'role' in author && author.role ? { ...author, line: [author.role, experience(author.years)].filter(Boolean).join(' · ') } : null;
const updated = article.dateModified.slice(0, 10) !== article.datePublished.slice(0, 10);
// Newest other posts (the related-posts module; the links a writer placed in the text do the real linking).
const others = pages.filter((other) => other.pageType === 'blog_post' && other.route !== page.route && other.status === page.status)
  .sort((left, right) => Date.parse(right.article!.dateModified) - Date.parse(left.article!.dateModified)).slice(0, 3);
const sidebar = layout === 'sidebar-start' || layout === 'sidebar-end';
const image = article.image;
// The post's photo from the sizes built for it, as the hub's cards' (lib/web-image.mjs photoSrcset: the post's image
// keeps its widest file only; 2026-11-20, MotelPilot's posts loaded the 1536px file first on a phone, LCP 4.0s): the
// screen's width over the title, the article's column (at most the container) inside it.
const imageSrcset = image ? photoSrcset(image) : undefined;
const ARTICLE_IMAGE_SIZES = '(min-width: 1280px) 1200px, 100vw';
const toc = sections.length >= 3;
// The title sized to its words as a page hero's is (scripts/lib/heading-fit.mjs), on the post title's own scale.
const fitStyle = headingFitStyle(page.hero.heading, { charEm: wrapEmFor(variants.heroText), fit: POST_TITLE_FIT });
---

<main id="main" data-authoring-page={page.id} data-page-type={page.pageType} data-page-status={page.status} data-post-layout={layout} style={articleRhythmStyle}>
  <Breadcrumbs page={page} />
  <header class="post-header" data-authoring-block="hero" data-layout="hero" data-boundary-anchor="box">
    {(layout === 'narrow' || layout === 'sidebar-end') && image && <figure class="post-header__image"><img src={image.src} srcset={imageSrcset} sizes={imageSrcset ? '100vw' : undefined} alt={image.alt} width={image.width} height={image.height} loading="eager" fetchpriority="high" decoding="async" style={focusStyle(image.src)} /></figure>}
    <div class="container post-header__inner" data-heading-fit={fitStyle ? '' : undefined} style={fitStyle}>
      {page.status === 'placeholder' && <p class="placeholder-badge">Placeholder copy</p>}
      {article.category && <p class="post-header__category">{article.category}</p>}
      <h1 class="post-header__title">{page.hero.heading}</h1>
      <p class="post-header__meta">
        <span class="post-byline">By <SmartLink href={author.href}>{author.name}</SmartLink></span>
        <PostDate value={article.datePublished} label="Published" />
        {updated && <PostDate value={article.dateModified} label="Updated" />}
        <span class="post-minutes">{article.minutes} min read</span>
      </p>
    </div>
  </header>
  <div class="container post-body" data-sidebar={sidebar ? layout : undefined}>
    {layout === 'sidebar-start' && toc && (
      <aside class="post-aside">
        <nav class="post-toc" aria-label="Contents"><p class="post-toc__title">Contents</p><ol>{sections.map((section) => <li><a href={`#${section.anchor}`}>{section.heading}</a></li>)}</ol></nav>
        <div class="post-author"><p class="post-author__name">{author.name}</p><SmartLink href={author.href}>About us</SmartLink></div>
      </aside>
    )}
    <article class="post-article">
      {(layout === 'sidebar-start' || layout === 'paper') && image && <figure class="post-article__image"><img src={image.src} srcset={imageSrcset} sizes={imageSrcset ? ARTICLE_IMAGE_SIZES : undefined} alt={image.alt} width={image.width} height={image.height} loading="eager" decoding="async" style={focusStyle(image.src)} /></figure>}
      <div class="post-intro">
        {page.hero.lead?.map((paragraph) => <p class="post-lead"><InlineText text={paragraph} /></p>)}
        {article.takeaways.length > 0 && (
          <div class="post-takeaways"><p class="post-takeaways__title">Key takeaways</p><ul>{article.takeaways.map((item) => <li>{item}</li>)}</ul></div>
        )}
        {layout !== 'sidebar-start' && toc && (
          <nav class="post-toc post-toc--inline" aria-label="Contents"><p class="post-toc__title">{layout === 'sidebar-end' ? 'Article overview' : 'Contents'}</p><ol>{sections.map((section) => <li><a href={`#${section.anchor}`}>{section.heading}</a></li>)}</ol></nav>
        )}
      </div>
      {page.blocks.map((block, index) => {
        if (block.type === 'prose') return (
          <>
            <ProseBlockView block={block} />
            {index === lastProse && card && (
              <aside class="post-author-card" aria-label="About the author">
                <p class="post-author-card__name"><SmartLink href={card.href}>{card.name}</SmartLink></p>
                <p class="post-author-card__role">{card.line}</p>
                {card.bio && <p class="post-author-card__bio">{card.bio}</p>}
              </aside>
            )}
          </>
        );
        if (block.type === 'faq') return <FaqBlock block={block} />;
        if (block.type === 'sources') return <SourcesBlock block={block} />;
        if (block.type === 'cta') return <CtaBlock block={block} variant="band" />;
        return null;
      })}
    </article>
    {layout === 'sidebar-end' && others.length > 0 && (
      <aside class="post-aside">
        <nav class="post-recent" aria-label="Recent posts"><p class="post-toc__title">Recent posts</p><ul>{others.map((other) => <li><a href={other.route}>{other.hero.heading}</a></li>)}</ul></nav>
      </aside>
    )}
  </div>
  {layout !== 'sidebar-end' && others.length > 0 && (
    <section class="post-related" aria-labelledby="related-heading">
      <div class="container">
        <h2 id="related-heading" class="post-related__heading">Related articles</h2>
        <ul class="post-related__list">{others.map((other) => <li><a href={other.route}>{other.hero.heading}</a></li>)}</ul>
      </div>
    </section>
  )}
</main>
